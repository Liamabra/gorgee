    "Gorgée n'a pas accès à la caméra. Autorise-la dans Réglages Système › Confidentialité › Caméra." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorgée can't access the camera. Allow it in System Settings › Privacy › Camera."
